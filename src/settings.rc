#define RT_MANIFEST 24

#include "resource.h"

2 RT_MANIFEST "src\\YamlTools.manifest"

// ─── version info (Notepad++ plugin list / update checks) ────────────────────

1 VERSIONINFO
FILEVERSION     YAMLTOOLS_VERSION_COMMA
PRODUCTVERSION  YAMLTOOLS_VERSION_COMMA
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x2L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Datamodder"
            VALUE "FileDescription",  "Datamodder YAML Tools for Notepad++"
            VALUE "FileVersion",      YAMLTOOLS_VERSION
            VALUE "InternalName",     "YamlTools"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Datamodder"
            VALUE "OriginalFilename", "YamlTools.dll"
            VALUE "ProductName",      "Datamodder YAML Tools"
            VALUE "ProductVersion",   YAMLTOOLS_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
