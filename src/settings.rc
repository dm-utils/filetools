#define RT_MANIFEST 24

#include "resource.h"

2 RT_MANIFEST "src\\FileTools.manifest"

// ─── version info (Notepad++ plugin list / update checks) ────────────────────

1 VERSIONINFO
FILEVERSION     FILETOOLS_VERSION_COMMA
PRODUCTVERSION  FILETOOLS_VERSION_COMMA
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x2L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Datamodder"
            VALUE "FileDescription",  "Datamodder File Tools for Notepad++"
            VALUE "FileVersion",      FILETOOLS_VERSION
            VALUE "InternalName",     "FileTools"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Datamodder"
            VALUE "OriginalFilename", "FileTools.dll"
            VALUE "ProductName",      "Datamodder File Tools"
            VALUE "ProductVersion",   FILETOOLS_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
