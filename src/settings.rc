#define IDOK        1
#define IDCANCEL    2
#define WS_TABSTOP  0x00010000
#define RT_MANIFEST 24

#include "resource.h"

2 RT_MANIFEST "src\\FileTools.manifest"

// ─── version info (Notepad++ plugin list / update checks) ────────────────────

1 VERSIONINFO
FILEVERSION     FILETOOLS_VERSION_COMMA
PRODUCTVERSION  FILETOOLS_VERSION_COMMA
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x2L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Datamodder"
            VALUE "FileDescription",  "Datamodder File Tools for Notepad++"
            VALUE "FileVersion",      FILETOOLS_VERSION
            VALUE "InternalName",     "FileTools"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Datamodder"
            VALUE "OriginalFilename", "FileTools.dll"
            VALUE "ProductName",      "Datamodder File Tools"
            VALUE "ProductVersion",   FILETOOLS_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// ─── about dialog ─────────────────────────────────────────────────────────────

IDD_ABOUT DIALOG 0, 0, 300, 264
STYLE 0x80C80040
CAPTION "About Datamodder File Tools"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Datamodder File Tools", -1, 10, 8, 280, 10
    LTEXT "", IDC_ABOUT_BODY, 10, 22, 280, 175
    CONTROL "<a href=""https://datamodder.com/utils/file-tools"">https://datamodder.com/utils/file-tools</a>", IDC_ABOUT_LINK_WEBSITE, "SysLink", WS_TABSTOP, 10, 200, 280, 12
    CONTROL "<a href=""https://github.com/dm-utils/filetools"">https://github.com/dm-utils/filetools</a>", IDC_ABOUT_LINK, "SysLink", WS_TABSTOP, 10, 214, 280, 12
    DEFPUSHBUTTON "OK", IDOK, 243, 244, 47, 14
END
